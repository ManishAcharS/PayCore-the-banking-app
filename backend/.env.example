# PayCore Backend Environment Variables
PORT=3000

# Database URLs
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/paycore?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
